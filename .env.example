# DEFENSA TI - Variables de Entorno

# API Key de Google Gemini (Para remediación contextual generativa)
# Si no se suministra, el auditor conmuta automáticamente al motor local OWASP ($0 costo)
GEMINI_API_KEY=
# Modelo de Gemini. Vacío = gemini-flash-lite-latest (alias que sigue al modelo vigente).
# Si Google retira un modelo, se cambia aquí sin tocar código.
GEMINI_MODEL=

# Webhook para notificación instantánea de prospectos comerciales (Slack / Discord / Zapier)
LEAD_WEBHOOK_URL=

# Proveedores de Contingencia Opcionales (Multi-Tier LLM Fallback)
GROQ_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Turnstile Anti-Bot
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ZoomEye Cyberspace Search Engine API v2 (Reconocimiento OSINT y detección de puertos pasiva)
ZOOMEYE_API_KEY=

# --- Operación y administración ---

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL=https://neuronalgravity.com

# Token del panel interno de prospectos (/admin/leads). Mínimo 16 caracteres.
# Generar con: openssl rand -hex 32
ADMIN_TOKEN=

# Secreto HMAC para firmar los sellos verificados. Si se deja vacío se genera uno
# automáticamente en data/.badge-secret. Generar con: openssl rand -hex 32
BADGE_SECRET=

# Horas que se conservan los informes del escáner público antes de depurarse (por defecto 24,
# igual que promete la política de privacidad). Las auditorías completas de clientes no caducan.
REPORT_RETENTION_HOURS=

# Llave PÚBLICA de Culqi para el checkout de aportes (pk_...). La llave secreta nunca va aquí.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=

# Google Analytics 4 (formato G-XXXXXXXXXX). Sin este valor no se mide ninguna conversión.
NEXT_PUBLIC_GA_ID=

# Resend: envío del correo de aviso por cada prospecto nuevo
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# Telegram: aviso instantáneo de prospectos y alertas del monitor de mantenimiento
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Motor de inteligencia de vulnerabilidades (opcionales) ---
# NVD: sin clave, 5 consultas cada 30 s. Clave gratuita: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# CertSpotter: más subdominios por Certificate Transparency. https://sslmate.com/certspotter/api/
CERTSPOTTER_API_KEY=
# Ruta al binario de Nuclei (solo auditoría completa). Si no se define, se busca "nuclei" en el PATH.
NUCLEI_PATH=

# --- Auditoría autorizada (worker, Node >= 22.13) ---
# Remitente verificado en Resend para las alertas
ALERT_FROM_EMAIL=
NMAP_PATH=
TESTSSL_PATH=
DOCKER_PATH=
ZAP_IMAGE=
# Firma de los enlaces de informes de auditoría completa (si falta se genera en data/.share-secret)
SHARE_SECRET=
# Copias de seguridad cifradas (npm run backup): clave de al menos 12 caracteres, guárdala fuera del servidor
BACKUP_PASSPHRASE=
BACKUP_DIR=
BACKUP_KEEP=14
# Vulnerabilidades de plugins de WordPress (wpscan.com, plan gratuito: 25 consultas al día)
WPSCAN_API_TOKEN=
# Credenciales filtradas por dominio (haveibeenpwned.com, de pago; el dominio debe estar verificado allí)
HIBP_API_KEY=
# Rastreo con navegador para aplicaciones de una sola página: 1 lo activa (requiere Chrome o Edge)
AUDIT_BROWSER=
CHROME_PATH=
# Revisión interna: rutas de las herramientas si no están en el PATH
SEMGREP_PATH=
GITLEAKS_PATH=
TRIVY_PATH=
# Buckets adivinados por nombre: pueden ser de terceros. Solo con 1 y alcance escrito
ASM_BUCKET_DISCOVERY=
# Ubicación real del nodo auditor. Vacío = el informe muestra N/D
AUDITOR_PROVIDER=
AUDITOR_REGION=
AUDITOR_LAT=
AUDITOR_LON=
